#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Pre-commit hook para Autorun
# Ejecuta linting, formateo y verificación de Autorun antes de commit

echo "🔍 [Pre-commit] Ejecutando verificaciones..."

# 1. Linting y formateo
echo "📋 [Pre-commit] Ejecutando lint y format..."
npm run lint && npm run format

if [ $? -ne 0 ]; then
  echo "❌ [Pre-commit] Lint o format falló"
  exit 1
fi

# 2. Verificación de Autorun (solo archivos en prototypes/)
echo "✅ [Pre-commit] Verificando cambios en prototypes/ con verifyDiff..."
npm run prototypes:verify -- --staged

if [ $? -ne 0 ]; then
  echo "❌ [Pre-commit] Verificación de prototypes falló"
  echo "   Los archivos en prototypes/ deben tener watermark AUTORUN y pasar todas las validaciones"
  echo "   Usa 'autorun.apply()' para implementar componentes correctamente"
  exit 1
fi

echo "✅ [Pre-commit] Todas las verificaciones pasaron"
exit 0
