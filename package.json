{
	"name": "autorun",
	"version": "1.0.0",
	"description": "Sistema modular para crear prototipos de alta calidad con componentes UBITS, add-ons funcionales y herramientas de desarrollo integradas.",
	"main": "index.js",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"lint": "biome check .",
		"format": "biome format . --write",
		"prepare": "husky",
		"verify": "node scripts/verify-setup.js",
		"init": "tsx packages/autorun-core/src/cli/autorun-init.ts",
		"autorun:init": "npm run init",
		"postinstall": "npm run verify",
		"wizard": "node scripts/run-init.js"
	},
	"bin": {
		"autorun-init": "./packages/autorun-core/dist/cli/autorun-init.js"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.3.2",
		"husky": "^9.1.7",
		"style-dictionary": "^4.4.0",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3",
		"vite": "^7.1.12"
	},
	"dependencies": {
		"@fortawesome/fontawesome-pro": "^7.1.0",
		"@fortawesome/fontawesome-svg-core": "^7.1.0",
		"@fortawesome/pro-light-svg-icons": "^7.1.0",
		"@fortawesome/pro-regular-svg-icons": "^7.1.0",
		"@fortawesome/pro-solid-svg-icons": "^7.1.0",
		"@fortawesome/pro-thin-svg-icons": "^7.1.0"
	}
}
