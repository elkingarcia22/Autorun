{
	"name": "autorun",
	"version": "1.0.0",
	"description": "Sistema modular para crear prototipos de alta calidad con componentes UBITS, add-ons funcionales y herramientas de desarrollo integradas.",
	"main": "index.js",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"lint": "biome check packages/ scripts/",
		"lint:all": "biome check . --skip-errors",
		"lint:file": "biome check",
		"lint:prototypes": "biome check prototypes/ --skip-errors",
		"format": "biome format . --write",
		"prepare": "husky",
		"verify": "node scripts/verify-setup.js",
		"init": "tsx packages/autorun-core/src/cli/autorun-init.ts",
		"autorun:init": "npm run init",
		"autorun:init-hub": "tsx packages/autorun-core/src/cli/autorun-init-hub.ts",
		"autorun:daemon": "tsx packages/autorun-core/src/cli/autorun-daemon.ts",
		"autorun:install-mcp": "tsx packages/autorun-core/src/cli/install-autorun-mcp.ts",
		"autorun:mcp-server": "tsx packages/autorun-core/src/cli/autorun-mcp-server.ts",
		"storybook:connect": "tsx packages/autorun-core/src/cli/storybook-connect.ts connect",
		"storybook:disconnect": "tsx packages/autorun-core/src/cli/storybook-connect.ts disconnect",
		"storybook:list": "tsx packages/autorun-core/src/cli/storybook-connect.ts list",
		"storybook:set-active": "tsx packages/autorun-core/src/cli/storybook-connect.ts set-active",
		"setup-storybook-mcp": "node scripts/setup-storybook-mcp-auto.js",
		"generate-storybook-inventory": "tsx scripts/generate-storybook-inventory.ts",
		"setup-project": "node scripts/create-project-package-json.js",
		"postinstall": "npm run verify",
		"wizard": "node scripts/run-init.js",
		"open:browser": "node scripts/open-in-cursor-browser.js",
		"deploy:index": "bash scripts/deploy-index.sh",
		"deploy:index:preview": "cd deploy && npx vercel",
		"deploy": "vercel --prod",
		"deploy:preview": "vercel"
	},
	"bin": {
		"autorun-init": "./packages/autorun-core/dist/cli/autorun-init.js"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.3.2",
		"husky": "^9.1.7",
		"style-dictionary": "^4.4.0",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3",
		"vercel": "^49.1.2",
		"vite": "^7.2.6"
	},
	"dependencies": {
		"@fortawesome/fontawesome-pro": "^7.1.0",
		"@fortawesome/fontawesome-svg-core": "^7.1.0",
		"@fortawesome/pro-light-svg-icons": "^7.1.0",
		"@fortawesome/pro-regular-svg-icons": "^7.1.0",
		"@fortawesome/pro-solid-svg-icons": "^7.1.0",
		"@fortawesome/pro-thin-svg-icons": "^7.1.0"
	}
}
