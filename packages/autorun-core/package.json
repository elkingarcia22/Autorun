{
  "name": "@autorun/core",
  "version": "1.0.0",
  "description": "Autorun Hub - Orquestador central de add-ons",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "biome check .",
    "format": "biome format . --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "mcp-server": "node dist/cli/autorun-mcp-server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.15",
    "typescript": "^5.3.0",
    "vite": "^7.2.6",
    "vitest": "^4.0.15"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./helpers/componentHelpers.js": {
      "import": "./dist/helpers/componentHelpers.js",
      "types": "./dist/helpers/componentHelpers.d.ts"
    }
  }
}
