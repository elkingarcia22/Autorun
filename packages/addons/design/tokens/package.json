{
  "name": "@autoframe/tokens",
  "version": "1.0.0",
  "description": "Tokens Autoframe genéricos como add-on intercambiable",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "npm run build:tokens && tsc",
    "build:tokens": "node ../../../tokens/build-css.cjs && cp ../../../tokens/dist/tokens.css ./dist/tokens.css && cp ../../../tokens/dist/tokens.js ./dist/tokens.js",
    "dev": "tsc --watch",
    "lint": "biome check .",
    "format": "biome format . --write"
  },
  "dependencies": {
    "@autoframe/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vite": "^7.1.12"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.js": "./dist/tokens.js"
  }
}

