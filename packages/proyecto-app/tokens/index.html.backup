    <style>
      /* Asegurar que FontAwesome se cargue correctamente */
      /* Si las fuentes no cargan, las clases .fa-*::before mostrarán el contenido unicode */
      .fa, .far, .fas, i[class*="fa-"] {
        font-family: 'Font Awesome 6 Pro', var(--fa-style-family, 'Font Awesome 6 Pro');
        font-style: normal;
        font-weight: 400;
        display: inline-block;
        line-height: 1;
        text-rendering: auto;
        -webkit-font-smoothing: antialiased;
      }
      .fas, i[class*="fas"] {
        font-weight: 900;
      }
      /* Fallback: Si las fuentes no cargan, mostrar unicode directamente */
      /* Estos códigos vienen del CSS de FontAwesome */
      .fa-plus::before { content: '\2b'; }
      .fa-check::before { content: '\f00c'; }
      .fa-trash::before { content: '\f1f8'; }
      .fa-edit::before { content: '\f044'; }
      .fa-user::before { content: '\f007'; }
      .fa-globe::before { content: '\f0ac'; }
      .fa-print::before { content: '\f02f'; }
      .fa-bars::before { content: '\f0c9'; }
      .fa-truck::before { content: '\f0d1'; }
      .fa-ghost::before { content: '\f6e2'; }
    </style>
    <style>
      /* ========================================
         AUTOFRAME - ESTILOS PRINCIPALES
         Sistema de diseño Autoframe
         ======================================== */
      
      /* Reset y Base */
      * {
        box-sizing: border-box;
      }
      
      html {
        scroll-behavior: smooth;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      
      body {
        font-family: var(--font-sans, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif);
        margin: 0;
        padding: 0;
        background: var(--ubits-bg-2, #F3F3F4) !important;
        color: var(--ubits-fg-2-high, #2a303f);
        line-height: var(--font-body-md-line, 1.5);
        font-size: var(--font-body-md-size, 14px);
        transition: background-color 0.3s ease, color 0.3s ease;
      }
      
      [data-theme="dark"] body {
        background: var(--ubits-bg-2, #0E1825) !important;
        color: var(--ubits-fg-2-high, #ffffff);
      }
      
      /* Layout y Contenedores */
      #sections-host {
        max-width: 1120px;
        margin: 0 auto;
        padding: 24px 16px;
        min-height: calc(100vh - 80px);
      }
      
      .container {
        max-width: 1120px;
        margin: 0 auto;
        width: 100%;
        padding: 0 16px;
      }
      
      /* Tipografía */
      h1, .ubits-heading-h1 {
        font-family: var(--font-sans);
        font-size: var(--font-h1-size, 32px);
        font-weight: var(--weight-bold, 700);
        line-height: var(--font-h1-line, 1.2);
        margin: 0 0 8px 0;
        color: var(--ubits-fg-2-high, #2a303f);
        letter-spacing: -0.02em;
      }
      
      [data-theme="dark"] h1,
      [data-theme="dark"] .ubits-heading-h1 {
        color: var(--ubits-fg-2-high, #ffffff);
      }
      
      h2, .ubits-heading-h2 {
        font-family: var(--font-sans);
        font-size: var(--font-h2-size, 24px);
        font-weight: var(--weight-semibold, 600);
        line-height: var(--font-h2-line, 1.3);
        margin: 0 0 12px 0;
        color: var(--ubits-fg-1-high, #303a47);
      }
      
      h3, .ubits-heading-h3 {
        font-family: var(--font-sans);
        font-size: var(--font-h3-size, 20px);
        font-weight: var(--weight-semibold, 600);
        line-height: var(--font-h3-line, 1.4);
        margin: 0 0 12px 0;
        color: var(--ubits-fg-1-high, #303a47);
      }
      
      h4 {
        font-family: var(--font-sans);
        font-size: var(--font-h4-size, 18px);
        font-weight: var(--weight-semibold, 600);
        line-height: var(--font-h4-line, 1.4);
        margin: 0 0 8px 0;
        color: var(--ubits-fg-1-high, #303a47);
      }
      
      p {
        font-family: var(--font-sans);
        font-size: var(--font-body-md-size, 14px);
        line-height: var(--font-body-md-line, 1.5);
        margin: 0 0 16px 0;
        color: var(--ubits-fg-1-medium, #5c646f);
      }
      
      .subtitle {
        font-family: var(--font-sans);
        font-size: var(--font-body-md-size, 14px);
        line-height: var(--font-body-md-line, 1.5);
        margin: 0 0 24px 0;
        color: var(--ubits-fg-2-medium, #5a5e6a);
        font-weight: var(--weight-regular, 400);
      }
      
      /* Grid y Layout */
      .columns {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
      }
      
      .columns + .columns {
        margin-top: 24px;
      }
      
      @media (max-width: 768px) {
        .columns {
          grid-template-columns: 1fr;
        }
      }
      
      .grid {
        display: grid;
        grid-template-columns: 240px 1fr;
        gap: 8px;
        align-items: center;
      }
      
      .row {
        display: contents;
      }
      
      /* Cards y Paneles */
      .panel {
        border: none;
        border-radius: 12px;
        padding: 24px;
        background: var(--ubits-bg-1, #ffffff);
        box-shadow: var(--ubits-effects-elevation-1, 0px 1px 2px 0px rgba(0, 0, 0, 0.12));
        transition: box-shadow 0.2s ease, transform 0.2s ease;
      }
      
      [data-theme="dark"] .panel {
        background: var(--ubits-bg-1, #202837);
        box-shadow: var(--ubits-effects-elevation-1, 0px 1px 2px 0px rgba(0, 0, 0, 0.3));
      }
      
      .panel.dark {
        background: var(--ubits-bg-2, #F3F3F4);
        color: var(--ubits-fg-2-high, #2a303f);
        border: none;
      }
      
      [data-theme="dark"] .panel.dark {
        background: var(--ubits-bg-2, #0E1825);
        color: var(--ubits-fg-2-high, #ffffff);
      }
      
      .kcard {
        background: var(--ubits-bg-1, #ffffff);
        border: none;
        border-radius: 12px;
        padding: 24px;
        box-shadow: var(--ubits-effects-elevation-1, 0px 1px 2px 0px rgba(0, 0, 0, 0.12));
        transition: box-shadow 0.2s ease, transform 0.2s ease;
      }
      
      [data-theme="dark"] .kcard {
        background: var(--ubits-bg-1, #202837);
        box-shadow: var(--ubits-effects-elevation-1, 0px 1px 2px 0px rgba(0, 0, 0, 0.3));
      }
      
      .kcard:hover {
        box-shadow: var(--ubits-effects-elevation-2, 0px 2px 4px 0px rgba(0, 0, 0, 0.16));
      }
      
      .kstack {
        display: grid;
        gap: 12px;
      }
      
      /* Secciones */
      .section {
        display: none;
        padding-top: 32px;
        animation: fadeIn 0.3s ease;
      }
      
      .section.active {
        display: block;
      }
      
      .section > h1 {
        margin-top: 0 !important;
        margin-bottom: 8px;
      }
      
      .section-title {
        font-weight: var(--weight-bold, 700);
        margin: 0 0 12px 0;
        color: var(--ubits-fg-1-high, #303a47);
        font-size: var(--font-body-md-size, 14px);
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }
      
      /* Tokens y Swatches */
      .token-name {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        font-family: 'Monaco', 'Menlo', monospace;
        font-size: var(--font-body-sm-size, 12px);
        color: var(--ubits-fg-1-medium, #5c646f);
      }
      
      .swatch {
        height: 28px;
        border: none;
        border-radius: 6px;
        margin-bottom: 4px;
        box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.1);
      }
      
      /* Código */
      code {
        font-family: 'Monaco', 'Menlo', 'Courier New', monospace;
        font-size: var(--font-body-sm-size, 12px);
        color: inherit;
        opacity: 0.85;
        background: var(--ubits-bg-2, #F3F3F4);
        padding: 2px 6px;
        border-radius: 4px;
      }
      
      [data-theme="dark"] code {
        background: var(--ubits-bg-3, #0c121c);
      }
      
      pre {
        font-family: 'Monaco', 'Menlo', 'Courier New', monospace;
        font-size: var(--font-body-sm-size, 12px);
        line-height: var(--font-body-md-line, 1.5);
        overflow-x: auto;
      }
      
      /* Elementos interactivos */
      .copyable {
        cursor: pointer;
        transition: all 0.2s ease;
      }
      
      .copyable:hover {
        opacity: 0.8;
      }
      
      .copied {
        outline: 2px solid var(--ubits-accent-green, #13BD74);
        outline-offset: 2px;
      }
      
      .icon-card.copyable:hover {
        border-color: var(--ubits-accent-brand-static-inverted, #0c5bef) !important;
        background: var(--ubits-bg-active, rgba(12, 91, 239, 0.2)) !important;
        transform: translateY(-2px);
        box-shadow: var(--ubits-effects-elevation-3, 0px 4px 8px 0px rgba(0, 0, 0, 0.2));
      }
      
      /* Iconos */
      .letter-section {
        margin-bottom: 32px;
      }
      
      .letter-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 12px;
      }
      
      /* Toast */
      .toast {
        position: fixed;
        left: 50%;
        bottom: 24px;
        transform: translateX(-50%);
        background: var(--ubits-bg-1, #ffffff);
        color: var(--ubits-fg-2-high, #2a303f);
        padding: 12px 16px;
        border-radius: 8px;
        box-shadow: var(--ubits-effects-elevation-4, 0px 8px 16px 0px rgba(0, 0, 0, 0.24));
        font-size: var(--font-body-sm-size, 12px);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s ease, transform 0.2s ease;
        z-index: 10000;
      }
      
      [data-theme="dark"] .toast {
        background: var(--ubits-bg-1, #202837);
        color: var(--ubits-fg-2-high, #ffffff);
      }
      
      .toast.show {
        opacity: 1;
        transform: translateX(-50%) translateY(-4px);
      }
      
      /* Navegación antigua */
      .navbar {
        display: flex;
        gap: 20px;
        align-items: center;
        padding: 10px 0;
        border-bottom: none;
        position: sticky;
        top: 0;
        background: var(--ubits-bg-2, #F3F3F4);
        z-index: 20;
        backdrop-filter: blur(10px);
      }
      
      [data-theme="dark"] .navbar {
        background: var(--ubits-bg-2, #0E1825);
      }
      
      .nav-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 2px;
        color: var(--ubits-fg-2-medium, #5a5e6a);
        text-decoration: none;
        font-weight: var(--weight-semibold, 600);
        line-height: 1;
        border-bottom: 2px solid transparent;
        transition: all 0.2s ease;
      }
      
      .nav-link:hover {
        color: var(--ubits-fg-2-high, #2a303f);
      }
      
      [data-theme="dark"] .nav-link:hover {
        color: var(--ubits-fg-2-high, #ffffff);
      }
      
      .nav-link.active {
        color: var(--ubits-accent-brand-static-inverted, #0c5bef);
        border-bottom-color: var(--ubits-accent-brand-static-inverted, #0c5bef);
      }
      
      .tabs-wrap {
        position: sticky;
        top: 0;
        z-index: 20;
        margin-bottom: 12px;
        background: var(--ubits-bg-2, #F3F3F4);
        backdrop-filter: blur(10px);
      }
      
      [data-theme="dark"] .tabs-wrap {
        background: var(--ubits-bg-2, #0E1825);
      }
      
      /* Layout de colores */
      .layout-colors {
        display: flex;
        gap: 16px;
        align-items: flex-start;
      }
      
      .sidebar {
        width: 320px;
        flex-shrink: 0;
      }
      
      @media (max-width: 1024px) {
        .layout-colors {
          flex-direction: column;
        }
        
        .sidebar {
          width: 100%;
        }
      }
      
      .sidebox {
        position: sticky;
        top: 56px;
        border: none;
        border-radius: 12px;
        padding: 8px;
        background: var(--ubits-bg-1, #ffffff);
        box-shadow: var(--ubits-effects-elevation-1, 0px 1px 2px 0px rgba(0, 0, 0, 0.12));
      }
      
      [data-theme="dark"] .sidebox {
        background: var(--ubits-bg-1, #202837);
      }
      
      .side-title {
        font-size: var(--font-body-sm-size, 12px);
        color: var(--ubits-fg-1-medium, #5c646f);
        padding: 8px 10px;
        font-weight: var(--weight-semibold, 600);
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }
      
      .category-toggle:hover {
        background-color: var(--ubits-bg-2, #F3F3F4);
      }
      
      [data-theme="dark"] .category-toggle:hover {
        background-color: var(--ubits-bg-2, #0E1825);
      }
      
      .category-content {
        display: flex;
        flex-direction: column;
        gap: 6px;
        transition: opacity 0.2s ease;
      }
      
      .side {
        display: flex;
        flex-direction: column;
        gap: 6px;
        max-height: calc(100vh - 140px);
        overflow-y: auto;
        padding-right: 4px;
        scrollbar-width: thin;
        scrollbar-color: var(--ubits-fg-2-medium-static-inverted, #d0d2d5) transparent;
      }
      
      /* Scrollbar personalizado Autoframe */
      .side::-webkit-scrollbar {
        width: 8px;
      }
      
      .side::-webkit-scrollbar-track {
        background: transparent;
        border-radius: var(--ubits-border-radius-full, 1000px);
      }
      
      .side::-webkit-scrollbar-thumb {
        background: var(--ubits-fg-2-medium-static-inverted, #d0d2d5);
        border-radius: var(--ubits-border-radius-full, 1000px);
        opacity: 0;
        transition: opacity 0.3s ease;
      }
      
      .side:hover::-webkit-scrollbar-thumb {
        opacity: 1;
      }
      
      .side-link {
        padding: 8px 10px;
        border-radius: 8px;
        color: var(--ubits-fg-1-medium, #5c646f);
        text-decoration: none;
        font-weight: var(--weight-medium, 500);
        white-space: nowrap;
        transition: background 0.2s ease, color 0.2s ease;
        font-size: var(--font-body-sm-size, 12px);
      }
      
      .side-link:hover {
        background: var(--ubits-bg-2, #F3F3F4);
        color: var(--ubits-fg-2-high, #2a303f);
      }
      
      [data-theme="dark"] .side-link:hover {
        background: var(--ubits-bg-2, #0E1825);
        color: var(--ubits-fg-2-high, #ffffff);
      }
      
      .side-link.active {
        background: var(--ubits-bg-2, #F3F3F4);
        color: var(--ubits-accent-brand-static-inverted, #0c5bef);
        font-weight: var(--weight-semibold, 600);
      }
      
      [data-theme="dark"] .side-link.active {
        background: var(--ubits-bg-2, #0E1825);
      }
      
      .content {
        flex: 1;
        display: block;
        width: 100%;
        margin: 0;
        padding: 0;
      }
      
      
      /* Searchbar */
      .searchbar {
        margin: 8px 0 16px;
        display: flex;
        justify-content: flex-end;
      }
      
      .searchbar input {
        width: 360px;
        max-width: 100%;
        padding: 10px 12px;
        border: 1px solid var(--ubits-border-1, #d0d2d5);
        border-radius: 8px;
        background: var(--ubits-bg-1, #ffffff);
        color: var(--ubits-fg-1-high, #303a47);
        font-family: var(--font-sans);
        font-size: var(--font-body-md-size, 14px);
        transition: all 0.2s ease;
      }
      
      [data-theme="dark"] .searchbar input {
        background: var(--ubits-bg-1, #202837);
        color: var(--ubits-fg-1-high, #edeeef);
        border-color: var(--ubits-border-1, #4f5561);
      }
      
      .searchbar input:focus {
        outline: none;
        border-color: var(--ubits-accent-brand-static-inverted, #0c5bef);
        box-shadow: 0 0 0 3px var(--ubits-button-focus-ring, rgba(82, 151, 244, 0.3));
      }
      
      /* Estilos para bloques copiables */
      .copyable-code-block {
        position: relative;
      }
      
      .copyable-code-block pre {
        position: relative;
        padding-right: 40px;
        cursor: pointer;
        transition: background 0.2s;
      }
      
      .copyable-code-block pre:hover {
        background: var(--ubits-bg-active, rgba(12, 91, 239, 0.2)) !important;
      }
      
      .copyable-code-block .copy-btn {
        position: absolute;
        top: 8px;
        right: 8px;
        background: var(--ubits-bg-1, #ffffff);
        border: 1px solid var(--ubits-border-1, #d0d2d5);
        border-radius: 6px;
        padding: 6px 10px;
        cursor: pointer;
        font-size: var(--font-body-sm-size, 12px);
        color: var(--ubits-fg-1-medium, #5c646f);
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 6px;
      }
      
      [data-theme="dark"] .copyable-code-block .copy-btn {
        background: var(--ubits-bg-1, #202837);
        border-color: var(--ubits-border-1, #4f5561);
        color: var(--ubits-fg-1-medium, #d0d2d5);
      }
      
      .copyable-code-block .copy-btn:hover {
        background: var(--ubits-accent-brand-static-inverted, #0c5bef);
        color: var(--ubits-bg-1, #ffffff);
        border-color: var(--ubits-accent-brand-static-inverted, #0c5bef);
      }
      
      .copyable-code-block .copy-btn.copied {
        background: var(--ubits-accent-green, #13BD74);
        color: var(--ubits-bg-1, #ffffff);
        border-color: var(--ubits-accent-green, #13BD74);
      }
      
      .copyable-code-block .copy-btn i {
        font-size: var(--font-body-sm-size, 12px);
      }
      
      .copyable-prompt {
        position: relative;
      }
      
      .copyable-prompt .copy-btn {
        position: absolute;
        top: 12px;
        right: 12px;
        background: var(--ubits-bg-1, #ffffff);
        border: 1px solid var(--ubits-border-1, #d0d2d5);
        border-radius: 6px;
        padding: 8px 12px;
        cursor: pointer;
        font-size: var(--font-body-sm-size, 12px);
        color: var(--ubits-fg-1-medium, #5c646f);
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 6px;
      }
      
      [data-theme="dark"] .copyable-prompt .copy-btn {
        background: var(--ubits-bg-1, #202837);
        border-color: var(--ubits-border-1, #4f5561);
        color: var(--ubits-fg-1-medium, #d0d2d5);
      }
      
      .copyable-prompt .copy-btn:hover {
        background: var(--ubits-accent-brand-static-inverted, #0c5bef);
        color: var(--ubits-bg-1, #ffffff);
        border-color: var(--ubits-accent-brand-static-inverted, #0c5bef);
      }
      
      .copyable-prompt .copy-btn.copied {
        background: var(--ubits-accent-green, #13BD74);
        color: var(--ubits-bg-1, #ffffff);
        border-color: var(--ubits-accent-green, #13BD74);
      }
      
      .copyable-prompt .copy-btn i {
        font-size: var(--font-body-sm-size, 12px);
      }
      
      /* Animaciones */
      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: translateY(10px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      
      /* Navbar2 - Navegación principal Autoframe */
      #navbar2 {
        background: var(--ubits-bg-1, #ffffff);
        border-bottom: none;
        margin-bottom: 24px;
        padding: 12px 0;
        box-shadow: var(--ubits-effects-elevation-1, 0px 1px 2px 0px rgba(0, 0, 0, 0.12));
        backdrop-filter: blur(10px);
        position: sticky;
        top: 0;
        z-index: 30;
      }
      
      [data-theme="dark"] #navbar2 {
        background: var(--ubits-bg-1, #202837);
        box-shadow: var(--ubits-effects-elevation-1, 0px 1px 2px 0px rgba(0, 0, 0, 0.3));
      }
      
      #navbar2 .navbar2-container {
        display: flex;
        gap: 32px;
        align-items: center;
        border-radius: 8px;
      }
      
      #navbar2 .ubits-logo {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-right: 16px;
        text-decoration: none;
        transition: transform 0.2s ease;
      }
      
      #navbar2 .ubits-logo:hover {
        transform: scale(1.05);
      }
      
      #navbar2 .ubits-logo img {
        width: 28px;
        height: 28px;
        transition: filter 0.2s ease;
      }
      
      #navbar2 .ubits-logo:hover img {
        filter: brightness(1.1);
      }
      
      /* Mostrar logo según el tema */
      [data-theme="dark"] #navbar2 .autoframe-logo-dark {
        display: block !important;
      }
      
      [data-theme="dark"] #navbar2 .autoframe-logo-light {
        display: none !important;
      }
      
      [data-theme="light"] #navbar2 .autoframe-logo-dark {
        display: none !important;
      }
      
      [data-theme="light"] #navbar2 .autoframe-logo-light {
        display: block !important;
      }
      
      #navbar2 .ubits-logo-text {
        font-size: var(--font-body-lg-size, 18px);
        font-weight: var(--weight-bold, 700);
        color: var(--ubits-fg-1-high, #303a47);
        transition: color 0.2s ease;
      }
      
      [data-theme="dark"] #navbar2 .ubits-logo-text {
        color: var(--ubits-fg-1-high, #edeeef);
      }
      
      #navbar2 .ubits-logo:hover .ubits-logo-text {
        color: var(--ubits-accent-brand-static-inverted, #0c5bef);
      }
      
      #navbar2 .nav2-link {
        color: var(--ubits-fg-1-medium, #5c646f);
        text-decoration: none;
        padding: 10px 12px;
        border-bottom: 2px solid transparent;
        transition: all 0.15s ease;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: var(--font-body-md-size, 14px);
        font-weight: var(--weight-medium, 500);
        position: relative;
      }
      
      [data-theme="dark"] #navbar2 .nav2-link {
        color: var(--ubits-fg-1-medium, #d0d2d5);
      }
      
      #navbar2 .nav2-link i {
        font-size: var(--font-body-md-size, 14px);
      }
      
      #navbar2 .nav2-link:hover {
        color: var(--ubits-fg-1-high, #303a47);
        background: var(--ubits-bg-2, #F3F3F4);
        border-radius: 8px;
      }
      
      [data-theme="dark"] #navbar2 .nav2-link:hover {
        color: var(--ubits-fg-1-high, #edeeef);
        background: var(--ubits-bg-2, #0E1825);
      }
      
      #navbar2 .nav2-link.active2 {
        color: var(--ubits-accent-brand-static-inverted, #0c5bef);
        border-bottom-color: var(--ubits-accent-brand-static-inverted, #0c5bef);
      }
      
      #navbar2 .nav2-link.has-submenu {
        cursor: pointer;
      }
      
      #navbar2 .nav2-link.has-submenu .fa-chevron-down {
        transition: transform 0.2s ease;
      }
      
      #navbar2 .nav2-link.has-submenu.submenu-open .fa-chevron-down {
        transform: rotate(180deg);
      }
      
      #navbar2 .nav2-submenu {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        background: var(--ubits-bg-1, #ffffff);
        border-radius: 8px;
        padding: 8px 0;
        margin-top: 4px;
        min-width: 200px;
        box-shadow: var(--ubits-effects-elevation-3, 0px 4px 8px 0px rgba(0, 0, 0, 0.12));
        z-index: 1000;
        animation: fadeIn 0.2s ease;
      }
      
      [data-theme="dark"] #navbar2 .nav2-submenu {
        background: var(--ubits-bg-1, #202837);
        box-shadow: var(--ubits-effects-elevation-3, 0px 4px 8px 0px rgba(0, 0, 0, 0.3));
      }
      
      #navbar2 .nav2-link.submenu-open .nav2-submenu {
        display: block;
      }
      
      #navbar2 .nav2-submenu .nav2-subitem {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        color: var(--ubits-fg-1-medium, #5c646f);
        text-decoration: none;
        font-size: var(--font-body-sm-size, 12px);
        transition: all 0.15s ease;
      }
      
      [data-theme="dark"] #navbar2 .nav2-submenu .nav2-subitem {
        color: var(--ubits-fg-1-medium, #d0d2d5);
      }
      
      #navbar2 .nav2-submenu .nav2-subitem:hover {
        background: var(--ubits-bg-2, #F3F3F4);
        color: var(--ubits-fg-1-high, #303a47);
      }
      
      [data-theme="dark"] #navbar2 .nav2-submenu .nav2-subitem:hover {
        background: var(--ubits-bg-2, #0E1825);
        color: var(--ubits-fg-1-high, #edeeef);
      }
      
      #navbar2 .nav2-submenu .nav2-subitem.active {
        color: var(--ubits-accent-brand-static-inverted, #0c5bef);
        font-weight: var(--weight-semibold, 600);
      }
      
      #navbar2 .nav2-submenu .nav2-subitem i {
        font-size: var(--font-body-sm-size, 12px);
      }
      
      /* Dark Mode Toggle Button */
      #navbar2 .dark-mode-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        padding: 0;
        border: none;
        background: transparent;
        color: var(--ubits-fg-1-medium, #5c646f);
        cursor: pointer;
        border-radius: 8px;
        transition: all 0.15s ease;
        margin-left: auto;
      }
      
      [data-theme="dark"] #navbar2 .dark-mode-toggle {
        color: var(--ubits-fg-1-medium, #d0d2d5);
      }
      
      #navbar2 .dark-mode-toggle:hover {
        background: var(--ubits-bg-2, #F3F3F4);
        color: var(--ubits-fg-1-high, #303a47);
      }
      
      [data-theme="dark"] #navbar2 .dark-mode-toggle:hover {
        background: var(--ubits-bg-2, #0E1825);
        color: var(--ubits-fg-1-high, #edeeef);
      }
      
      #navbar2 .dark-mode-toggle:active {
        background: var(--ubits-bg-3, #e7e8ea);
        transform: scale(0.95);
      }
      
      [data-theme="dark"] #navbar2 .dark-mode-toggle:active {
        background: var(--ubits-bg-3, #0c121c);
      }
      
      #navbar2 .dark-mode-toggle i {
        font-size: var(--font-body-md-size, 14px);
        color: var(--ubits-fg-1-medium, #5c646f);
        transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        align-items: center;
        justify-content: center;
        width: 24px;
        height: 24px;
        margin: 0 auto;
      }
      
      [data-theme="dark"] #navbar2 .dark-mode-toggle i {
        color: var(--ubits-fg-1-medium, #d0d2d5);
      }
      
      #navbar2 .dark-mode-toggle i::before {
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        width: 100%;
        height: 100%;
      }
      
      /* Animación de transición de icono - una sola vuelta */
      #navbar2 .dark-mode-toggle i.ubits-icon-transition {
        animation: iconSpinFade 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      }
      
      @keyframes iconSpinFade {
        0% {
          transform: rotate(0deg) scale(1);
          opacity: 1;
        }
        50% {
          transform: rotate(180deg) scale(1.2);
          opacity: 0.6;
        }
        100% {
          transform: rotate(360deg) scale(1);
          opacity: 1;
        }
      }
      
      #navbar2 .dark-mode-toggle:hover i {
        color: var(--ubits-fg-1-high, #303a47);
      }
      
      [data-theme="dark"] #navbar2 .dark-mode-toggle:hover i {
        color: var(--ubits-fg-1-high, #edeeef);
      }
      
      /* Cambio de icono en modo oscuro */
      #navbar2 .dark-mode-toggle[data-theme="dark"] i {
        color: var(--ubits-fg-yellow-subtle, #ffd555);
      }
      
      #navbar2 .dark-mode-toggle[data-theme="light"] i {
        color: var(--ubits-fg-1-medium, #5c646f);
      }
      
      /* Espaciado entre navbar y títulos de secciones */
      .section {
        padding-top: 32px;
      }
      
      .section > h1 {
        margin-top: 0 !important;
        margin-bottom: 8px;
      }
      
      /* Unificar ancho en las secciones para evitar cambios de tamaño al navegar */
      #section-que-es > h1,
      #section-que-es > p.subtitle,
      #section-como-funciona > h1,
      #section-como-funciona > p.subtitle,
      #section-addons > h1,
      #section-addons > p.subtitle {
        max-width: 1120px;
        margin-left: auto;
        margin-right: auto;
        padding-left: 16px;
        padding-right: 16px;
      }
      
      /* Estilos adicionales para elementos comunes */
      a {
        color: var(--ubits-accent-brand-static-inverted, #0c5bef);
        text-decoration: none;
        transition: color 0.2s ease;
      }
      
      a:hover {
        color: var(--ubits-button-primary-hover, #223a91);
        text-decoration: underline;
      }
      
      ul, ol {
        margin: 0 0 16px 0;
        padding-left: 20px;
      }
      
      li {
        margin-bottom: 8px;
        color: var(--ubits-fg-1-medium, #5c646f);
        line-height: var(--font-body-md-line, 1.5);
      }
      
      [data-theme="dark"] li {
        color: var(--ubits-fg-1-medium, #d0d2d5);
      }
      
      strong {
        font-weight: var(--weight-semibold, 600);
        color: var(--ubits-fg-1-high, #303a47);
      }
      
      [data-theme="dark"] strong {
        color: var(--ubits-fg-1-high, #edeeef);
      }
      
      /* Responsive */
      @media (max-width: 1024px) {
        #navbar2 .navbar2-container {
          gap: 16px;
        }
        
        #navbar2 .nav2-link {
          padding: 8px 10px;
          font-size: var(--font-body-sm-size, 12px);
        }
        
        #sections-host {
          padding: 16px 12px;
        }
      }
      
      @media (max-width: 768px) {
        #navbar2 .navbar2-container {
          flex-wrap: wrap;
          gap: 8px;
        }
        
        #navbar2 .nav2-link span {
          display: none;
        }
        
        .searchbar input {
          width: 100%;
        }
        
        .layout-colors {
          flex-direction: column;
        }
        
        .sidebar {
          width: 100%;
          position: relative;
        }
        
        .sidebox {
          position: relative;
          top: 0;
        }
      }
    </style>
  </head>
  <body data-theme="dark">
    <!-- Nuevo menú interno, independiente del menú anterior -->
    <nav id="navbar2" style="display:block; position:sticky; top:0; z-index:30">
      <div class="container">
