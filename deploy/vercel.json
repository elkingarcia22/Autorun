{
	"version": 2,
	"buildCommand": null,
	"outputDirectory": ".",
	"framework": null,
	"installCommand": null,
	"cleanUrls": true,
	"trailingSlash": false,
	"rewrites": [
		{
			"source": "/(.*)",
			"destination": "/index.html"
		}
	],
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "Content-Type",
					"value": "text/html; charset=utf-8"
				},
				{
					"key": "Cache-Control",
					"value": "public, max-age=0, must-revalidate"
				}
			]
		}
	]
}
